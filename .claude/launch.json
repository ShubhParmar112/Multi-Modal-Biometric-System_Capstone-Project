{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["webapp/frontend/node_modules/vite/bin/vite.js", "webapp/frontend"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "webapp.backend.main:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
