# Copy this file to .env and fill in your actual keys.
# .env is gitignored and must never be committed.

GROQ_API_KEY=your_groq_api_key_here

# Signing key for web-app session tokens (JWT).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random key is generated and cached in .jwt_secret (gitignored):
# the app works and sessions survive restarts, but the key differs on every
# machine, so set this explicitly for anything you deploy.
JWT_SECRET=your_jwt_secret_here
